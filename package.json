{
  "name": "finvault",
  "version": "1.0.0",
  "description": "Production-oriented digital wallet backend built with Node.js, PostgreSQL, Redis and RabbitMQ",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"nodemon src/workers/outbox.worker.js\" \"nodemon src/workers/notification.worker.js\" \"nodemon src/workers/transactionExpiration.worker.js\"",
    "test": "jest --runInBand",
    "worker:notifications": "node src/workers/notification.worker.js",
    "worker:expiration": "node src/workers/transactionExpiration.worker.js",
    "worker:outbox": "node src/workers/outbox.worker.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "redis",
    "rabbitmq",
    "jwt",
    "wallet",
    "fintech"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "amqplib": "^2.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "resend": "^6.28.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
